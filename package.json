{
  "name": "coach-drill-designer",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "desktop:dev": "concurrently --kill-others -n next,electron -c cyan,yellow \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:build": "next build && electron-builder --win --publish=never",
    "desktop:build:mac": "next build && electron-builder --mac --publish=never",
    "desktop:package": "electron-builder --win --publish=never",
    "desktop:package:mac": "electron-builder --mac --publish=never"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^7.0.2",
    "@dnd-kit/utilities": "^3.2.2",
    "konva": "^9.3.14",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "puppeteer": "^24.39.0",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.4",
    "wait-on": "^7.2.0"
  }
}
